{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local work twin desktop pet window.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:8766/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-set-pet-view",
    "allow-start-window-drag",
    "allow-show-pet-menu",
    "allow-set-quota-effect"
  ]
}
